# Deploy DonnyRound on CELO Alfajores testnet
# Copy to .env and fill in values. Never commit .env.

# Wallet private key (with testnet CELO for gas). Get CELO from https://faucet.celo.org/alfajores
PRIVATE_KEY=0x...

# cUSD on Alfajores (default below)
CUSD_ADDRESS=0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1

# Charity wallet address (e.g. your address for testing)
CHARITY_WALLET=0x...

# Optional: for contract verification on Celoscan
# CELOSCAN_API_KEY=...

# Optional: WalletConnect project ID (for "Connect Wallet" on web, not in Farcaster)
# Get one at https://cloud.walletconnect.com/
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=...

# Sign in with Farcaster (AuthKit): app origin for SIWF (e.g. https://donny-app-rosy.vercel.app or http://localhost:3000)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
