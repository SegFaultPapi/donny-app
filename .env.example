# Deploy DonnyRound on CELO
# Copy to .env and fill in values. Never commit .env.

# --- Testnet: Celo Sepolia (faucet activo) ---
# Faucet: https://faucet.celo.org/celo-sepolia
# O: https://cloud.google.com/application/web3/faucet/celo/sepolia
PRIVATE_KEY=0x...

# Entry fee token: Celo Sepolia USDC
CUSD_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E

# Charity wallet address (e.g. your address for testing)
CHARITY_WALLET=0x...

# --- Mainnet: CELO ---
# Para mainnet usa: CUSD_ADDRESS=0x765DE816845861e75A25fCA122bb6bEB168b3DF4

# --- Frontend (set after deploy) ---
# NEXT_PUBLIC_DONNY_CONTRACT_ADDRESS=0x...
# NEXT_PUBLIC_CHARITY_WALLET=0x...

# --- Optional ---
# NEXT_PUBLIC_CHAIN=mainnet   # si despliegas en mainnet
# CELOSCAN_API_KEY=...
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=...
# NEXT_PUBLIC_APP_URL=http://localhost:3000
